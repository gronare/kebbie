Output docs/assets/clips/hub-connect.gif

Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 750
Set Padding 12
Set Framerate 12
Set TypingSpeed 45ms
Set CursorBlink false

Hide
Type `exec "$KDEMO_DIR/env.sh" herdr`
Enter
Sleep 4s
Ctrl+B
Type "b"
Sleep 300ms
Ctrl+B
Type "h"
Sleep 500ms
Type "h"
Sleep 800ms
Show

# H opens the hub window: kebbie's hub, or one you run yourself.
Sleep 1.5s
Type "H"
Sleep 2.5s
Type "o"
Sleep 800ms
Type "http://localhost:18471"
Sleep 600ms
Enter
Sleep 2.5s

# Connecting shows a card: a QR code of the link, the code to check on the page, the time left.
Enter
Sleep 9s
