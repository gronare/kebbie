Output docs/assets/clips/push-and-card.gif

Set Shell "bash"
Set FontSize 14
Set Width 1280
Set Height 720
Set Padding 10
Set Framerate 12
Set TypingSpeed 45ms
Set CursorBlink false

Hide
Type `exec "$KDEMO_DIR/env.sh" herdr`
Enter
Sleep 4s
Ctrl+B
Type "b"
Sleep 300ms
Ctrl+B
Type "h"
Sleep 500ms
Show

# checkout-copy is ready to push; its card shows a screenshot.
Sleep 1.2s
Type "j"
Sleep 500ms
Type "j"
Sleep 500ms
Type "j"
Sleep 1.2s
Type "s"
Sleep 4.5s

# The push window: the card above the commits.
Type "p"
Sleep 4s
Type "y"
Sleep 3s
Escape
Sleep 3s
