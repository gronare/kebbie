Output docs/assets/clips/getting-started.gif

Set Shell "bash"
Set FontSize 14
Set Width 1280
Set Height 720
Set Padding 10
Set Framerate 12
Set TypingSpeed 45ms
Set CursorBlink false

Hide
Type `exec "$KDEMO_DIR/env.sh" herdr`
Enter
Sleep 4s
Ctrl+B
Type "b"
Sleep 300ms
Ctrl+B
Type "h"
Sleep 500ms
Show

# A new task from the board: a name, then a prompt.
Sleep 1.5s
Type "n"
Sleep 700ms
Type "wishlist"
Sleep 400ms
Enter
Sleep 600ms
Type "Save products for later from the product page"
Sleep 600ms
Enter
Sleep 2.5s
Escape
Sleep 2s

# Find it, go to its Space and watch Claude work.
Type "/wish"
Sleep 600ms
Enter
Sleep 1.2s
Type "g"
Sleep 5.5s

# Back to the board: it reports ready.
Ctrl+B
Type " "
Sleep 3.5s
