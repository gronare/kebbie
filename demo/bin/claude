#!/usr/bin/env python3
# A stand-in for Claude Code in the demo: it draws a session from $KDEMO_DIR/screens, takes what is typed into it, and never calls a model.
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import textwrap
import time
import tty

demo = os.environ.get("KDEMO_DIR", "/tmp/kebbie-demo")


# kebbie's rules check asks a reviewer for a verdict on stdin; the demo's is $KDEMO_DIR/verdicts/<branch>, or a pass.
def rules_verdict():
    brief = "" if sys.stdin.isatty() else sys.stdin.read()
    if "this is a rules check" not in brief:
        return
    branch = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True).stdout.strip()
    short = subprocess.run(["git", "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    try:
        verdict = open(os.path.join(demo, "verdicts", branch)).read().replace("{sha}", short)
    except OSError:
        verdict = "verdict: ok\n"
    time.sleep(1)
    sys.stdout.write(verdict)


if {"-p", "--print"} & set(sys.argv[1:]):
    rules_verdict()
    sys.exit(0)
if {"--version", "plugin", "mcp"} & set(sys.argv[1:]):
    sys.exit(0)

here = os.path.basename(os.getcwd())
script_file = os.path.join(demo, "screens", here)
mode_file = os.path.join(demo, "modes", here)
branch = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True).stdout.strip()
react_file = os.path.join(demo, "react", branch if branch and branch != "HEAD" else here)
spinner = "⠂⠐⠠⠄"
home = os.environ.get("HOME", "")
cwd = os.getcwd()
shown_cwd = "~" + cwd[len(home):] if home and cwd.startswith(home) else cwd

DIM, ORANGE, BOLD, GREEN, RED, RESET = "\033[2m", "\033[38;5;173m", "\033[1m", "\033[32m", "\033[31m", "\033[0m"


def arg(name):
    args = sys.argv[1:]
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


session = arg("--session-id") or arg("--resume")
transcript = None
if session:
    folder = re.sub(r"[^A-Za-z0-9]", "-", cwd)
    transcript = os.path.join(home, ".claude", "projects", folder, f"{session}.jsonl")
    os.makedirs(os.path.dirname(transcript), exist_ok=True)
    open(transcript, "a").close()
    pane = os.environ.get("HERDR_PANE_ID")
    if pane:
        subprocess.Popen(["herdr", "pane", "report-agent-session", "--source", "herdr:claude", "--agent", "claude", "--agent-session-id", session, "--agent-session-path", transcript, pane],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# A pooled worktree that comes back with another task starts that task's session on a clean screen.
def fresh_screen():
    mark = os.path.join(demo, "screens", f".{here}.branch")
    try:
        before = open(mark).read().strip()
    except OSError:
        before = None
    if before is not None and before != branch:
        open(script_file, "w").close()
        open(mode_file, "w").close()
    with open(mark, "w") as out:
        out.write(branch)


def read_script():
    try:
        return open(script_file).read()
    except OSError:
        return ""


def script_stamp():
    try:
        return os.stat(script_file).st_mtime_ns
    except OSError:
        return 0


def mode():
    try:
        return open(mode_file).read().strip()
    except OSError:
        return "idle"


def wrapped(text, width):
    lines = []
    for line in text.splitlines():
        lines.extend(textwrap.wrap(line, width, subsequent_indent="  ") or [""])
    return lines


def colored(line):
    if line.startswith("> "):
        return f"{DIM}>{RESET} {line[2:]}"
    if line.startswith("● "):
        return f"{BOLD}●{RESET} {line[2:]}"
    if re.match(r"^\s+⎿\s+- ", line):
        return f"{RED}{line}{RESET}"
    if re.match(r"^ {5}\+ ", line):
        return f"{GREEN}{line}{RESET}"
    return line


def draw(state, tick):
    cols, rows = shutil.get_terminal_size()
    script = state["script"]
    title = script.splitlines()[0][2:42] if script.startswith("> ") else here
    head = ["\033[H\033[J", f"{ORANGE}✻{RESET} {BOLD}Claude Code{RESET}\r\n", f"{DIM}  {shown_cwd}{RESET}\r\n\r\n"]
    box = wrapped(state["input"], cols - 4) if state["input"] else [""]
    room = rows - 3 - len(box) - 3 - (2 if state["mode"] == "working" else 0)
    body = wrapped(script, cols - 2)
    while body and not body[-1].strip():
        body.pop()
    body = body[-room:] if room > 0 else []
    out = head + [colored(line) + "\r\n" for line in body]
    if state["mode"] == "working":
        spin = spinner[tick % 4]
        out.append(f"\033]0;{spin} {title}\007")
        out.append(f"\r\n{ORANGE}{spin}{RESET} Working… {DIM}({tick // 2 + 2}s · esc to interrupt){RESET}\r\n")
    else:
        out.append(f"\033]0;✳ {title}\007")
    rule = "─" * cols
    out.append(f"\033[{rows - 3 - len(box) + 1};1H{DIM}{rule}{RESET}\r\n")
    out += [f"{'❯' if i == 0 else ' '} {line}\033[K\r\n" for i, line in enumerate(box)]
    out.append(f"{DIM}{rule}{RESET}\r\n{DIM}  ? for shortcuts{RESET}")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


# kebbie checks the transcript for what it typed, so a submitted prompt lands there as the user's message, as in Claude Code.
def submit(text):
    if not read_script().startswith(f"> {text}\n"):
        with open(script_file, "a") as screen:
            screen.write(f"\n> {text}\n")
    if transcript:
        now = time.time()
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now)) + f".{int(now * 1000) % 1000:03d}Z"
        with open(transcript, "a") as log:
            log.write(json.dumps({"type": "user", "timestamp": stamp, "sessionId": session, "cwd": cwd, "message": {"role": "user", "content": text}}) + "\n")
    if os.access(react_file, os.X_OK):
        with open(react_file + ".log", "a") as log:
            subprocess.Popen([react_file, text], stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)


def main():
    fresh_screen()
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    tty.setraw(fd)
    sys.stdout.write("\033[?25l\033[?2004h")
    redraw = {"now": True}
    signal.signal(signal.SIGWINCH, lambda *_: redraw.update(now=True))
    state = {"mode": mode(), "input": "", "script": read_script(), "stamp": script_stamp()}
    tick = 0
    try:
        while True:
            if redraw["now"] or state["mode"] == "working":
                draw(state, tick)
                redraw["now"] = False
            ready, _, _ = select.select([fd], [], [], 0.5 if state["mode"] == "working" else 0.25)
            if state["mode"] == "working":
                tick += 1
            current = mode()
            if current != state["mode"]:
                state["mode"], redraw["now"] = current, True
                tick = 0
            stamp = script_stamp()
            if stamp != state["stamp"]:
                state["script"], state["stamp"], redraw["now"] = read_script(), stamp, True
            if not ready:
                continue
            data = os.read(fd, 65536).decode("utf-8", "replace")
            data = re.sub(r"\033\[[0-9;?]*[~A-Za-z]", "", data)
            for char in data:
                if char == "\x03":
                    return
                if char == "\r":
                    text = state["input"].strip()
                    state["input"] = ""
                    if text:
                        submit(text)
                        state["script"], state["stamp"] = read_script(), script_stamp()
                elif char == "\x7f":
                    state["input"] = state["input"][:-1]
                elif char == "\n" or char >= " ":
                    state["input"] += char
            redraw["now"] = True
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h\033[?2004l")


main()
