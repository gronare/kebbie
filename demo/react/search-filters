#!/bin/bash
# search-filters: takes the answer to its price question and builds the ranges.
. "$KDEMO_DIR/react/lib.sh"
text=$1
case "$text" in
  "[from you]"*)
    sleep 0.5
    mode working
    kebbie report --state working --next "nothing yet" "Building the fixed price ranges" >/dev/null
    say "● Fixed ranges, then, with your comment taken in. Adding the four ranges."
    sleep 2
    cat > src/search/price.ts <<'TS'
export const priceRanges = [
  { label: "Under 25", max: 25 },
  { label: "25 to 50", min: 25, max: 50 },
  { label: "50 to 100", min: 50, max: 100 },
  { label: "Over 100", min: 100 },
];
TS
    say "● Write(src/search/price.ts)"
    more "  ⎿  Wrote 6 lines"
    sleep 2
    git add src/search/price.ts && git commit -qm "Filter search results by fixed price ranges" -m "Shoppers asked to narrow by price as well as size. Four fixed ranges, under 25 up to over 100, sit beside the size filter; a range is one click and reads the same on every page."
    kebbie report --state ready --next "push it" "Price and size filters on the search page; prices in four fixed ranges" >/dev/null
    say "● Ready: price and size filters, prices in four fixed ranges."
    mode idle
    ;;
esac
